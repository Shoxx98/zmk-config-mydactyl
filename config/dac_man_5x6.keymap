#include <dt-bindings/zmk/pointing.h>

#define DEFAULT     0
#define FN          1
#define NUM         2
#define SYSCTRL     3
#define MOUSE       4
#define MATH        5
#define MATH_C      6
#define UMLAUT      7
#define CAMEL_CASE  8
#define SNAKE_CASE  9

#define INDEX_RCTRL 63
#define INDEX_LSHIFT 65
#define INDEX_LALT 66

#define TAP_MS 10
#define WAIT_MS 10
#define TIMEOUT_MS 120

