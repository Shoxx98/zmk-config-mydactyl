#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define FN 1
#define NUM 2
#define SYSCTRL 3


#define INDEX_RCTRL 63
#define INDEX_LSHIFT 65

// QWERTY ///////////////

// #define INDEX_U 23
// #define INDEX_O 25
// #define INDEX_S 31
// #define INDEX_A 29

// QWERTY ///////////////

// COLEMAK-DH ///////////
#define INDEX_U 24
#define INDEX_O 40
#define INDEX_S 31
#define INDEX_A 29
// COLEMAK-DH ///////////


// ZMK_MACRO(unicode_ae,
//     bindings = <&kp E &kp N4>)


/ {

    macros{

        ZMK_MACRO(linux_unicode_enter,
        bindings =  <&macro_press &kp LCTRL &kp LSHIFT &kp U>,
                    <&macro_release &kp LCTRL &kp LSHIFT &kp U>;
        )

        ZMK_MACRO(unicode_ue,
            bindings = <&kp F &kp C &kp ENTER>;
        )
        ZMK_MACRO(unicode_ae,
            bindings = <&kp E &kp N4 &kp ENTER>;
        )
        ZMK_MACRO(unicode_oe,
            bindings = <&kp F &kp N6 &kp ENTER>;
        )

        ZMK_MACRO(unicode_UE_shift,
            bindings = <&kp D &kp C &kp ENTER>;
        )
        ZMK_MACRO(unicode_AE_shift,
            bindings = <&kp C &kp N4 &kp ENTER>;
        )
        ZMK_MACRO(unicode_OE_shift,
            bindings = <&kp D &kp N6 &kp ENTER>;
        )

        ZMK_MACRO(unicode_sz,
            bindings = <&kp D &kp F &kp ENTER>;
        )
        ZMK_MACRO(linux_sz,
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&linux_unicode_enter >,
                       <&unicode_sz>;
        )

        ZMK_MACRO(unicode_SZ_shift,
            bindings = <&kp N1 &kp E &kp N9 &kp E &kp ENTER>;
        )
        ZMK_MACRO(linux_SZ_shift,
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&linux_unicode_enter >,
                       <&unicode_SZ_shift>;
        )

        ZMK_MACRO(linux_ue,
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&linux_unicode_enter >,
                       <&unicode_ue>;
        )
        ZMK_MACRO(linux_ae,
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =  <&linux_unicode_enter >,
                        <&unicode_ae>;
        )
        ZMK_MACRO(linux_oe,
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&linux_unicode_enter >,
                       <&unicode_oe>;
        )

        ZMK_MACRO(linux_UE_shift,
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&linux_unicode_enter >,
                       <&unicode_UE_shift>;
        )
        ZMK_MACRO(linux_AE_shift,
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =  <&linux_unicode_enter >,
                        <&unicode_AE_shift>;
        )
        ZMK_MACRO(linux_OE_shift,
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&linux_unicode_enter >,
                       <&unicode_OE_shift>;
        )

    };
    combos{
        compatible = "zmk,combos";

        combo_ue {
            timeout-ms = <100>;
            key-positions = <INDEX_RCTRL INDEX_U>;
            bindings =  <&linux_ue>;
        };
        combo_ae {
            timeout-ms = <100>;
            key-positions = <INDEX_RCTRL INDEX_A>;
            bindings =  <&linux_ae>;
        };
        combo_sz {
            timeout-ms = <100>;
            key-positions = <INDEX_RCTRL INDEX_S>;
            bindings =  <&linux_sz>;
        };
        combo_oe {
            timeout-ms = <100>;
            key-positions = <INDEX_RCTRL INDEX_O>;
            bindings =  <&linux_oe>;
        };

        combo_UE_shift {
            timeout-ms = <100>;
            key-positions = <INDEX_RCTRL INDEX_U INDEX_LSHIFT>;
            bindings =  <&linux_UE_shift>;
        };
        combo_AE_shift {
            timeout-ms = <100>;
            key-positions = <INDEX_RCTRL INDEX_A INDEX_LSHIFT>;
            bindings =  <&linux_AE_shift>;
        };
        combo_OE_shift {
            timeout-ms = <100>;
            key-positions = <INDEX_RCTRL INDEX_O INDEX_LSHIFT>;
            bindings =  <&linux_OE_shift>;
        };
        combo_SZ_shift {
            timeout-ms = <100>;
            key-positions = <INDEX_RCTRL INDEX_O INDEX_LSHIFT>;
            bindings =  <&linux_SZ_shift>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

// // QWERTY //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//         default_layer {
//             bindings = <
// &kp GRAVE   &kp N2     &kp N3    &kp N4     &kp N5     &kp N6       &kp HOME                            &kp PSCRN       &kp N7     &kp N8     &kp N9     &kp N0     &kp MINUS      &kp EQUAL
// &kp N1      &kp Q      &kp W     &kp E      &kp R      &kp T        &kp INSERT                          &kp PAGE_UP     &kp Y      &kp U      &kp I      &kp O      &kp P          &kp BSLH
// &kp TAB     &kp A      &kp S     &kp D      &kp F      &kp G        &kp END                             &kp PAGE_DOWN   &kp H      &kp J      &kp K      &kp L      &kp SEMICOLON  &kp APOSTROPHE
// &kp ESC     &kp Z      &kp X     &kp C      &kp V      &kp B                                                            &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH       &kp BSPC
//                        &tog NUM  &kp P                                                                                                        &kp LBKT   &kp RBKT
//                                             &kp ENTER    &kp SPACE   &kp LCTRL                          &tog FN &kp CAPS        &kp RCTRL
//                                             &kp LWIN     &kp LSHIFT  &kp LALT                           &kp DEL &kp RSHIFT      &kp RWIN
//             >;
//         };
// // QWERTY //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

// COLEMAK-DH //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
        default_layer {
            bindings = <
&kp GRAVE   &kp N2     &kp N3    &kp N4     &kp N5     &kp N6       &kp HOME                            &kp PAGE_UP     &kp N7     &kp N8     &kp N9     &kp N0     &kp MINUS      &kp EQUAL
&kp N1      &kp Q      &kp W     &kp F      &kp P      &kp B        &kp INSERT                          &kp PSCRN       &kp J      &kp L      &kp U      &kp Y      &kp SEMICOLON  &kp BSLH
&kp TAB     &kp A      &kp R     &kp S      &kp T      &kp G        &kp END                             &kp PAGE_DOWN   &kp M      &kp N      &kp E      &kp I      &kp O          &kp APOSTROPHE
&kp ESC     &kp Z      &kp X     &kp C      &kp D      &kp V                                                            &kp K      &kp H      &kp COMMA  &kp DOT    &kp FSLH       &kp BSPC
                       &tog NUM  &kp P                                                                                                        &kp LBKT   &kp RBKT
                                            &kp ENTER  &kp SPACE    &kp LCTRL                           &tog FN         &kp CAPS   &kp RCTRL
                                            &kp LWIN   &kp LSHIFT   &kp LALT                            &kp DEL         &kp RSHIFT &kp RWIN
            >;
        };
// COLEMAK-DH //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

        fn{
            bindings = <
&trans  &kp F2  &kp F3      &kp F4      &kp F5      &kp F6  &trans                                          &trans  &kp F7          &kp F8          &kp F9          &kp F10         &kp F11         &kp F12
&kp F1  &trans  &trans      &kp UP      &trans      &trans  &trans                                          &trans  &trans          &trans          &trans          &trans          &trans          &trans
&trans  &trans  &kp LEFT    &kp DOWN    &kp RIGHT   &trans  &trans                                          &trans  &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &trans
&trans  &trans  &trans      &trans      &trans      &trans                                                          &trans          &trans          &out OUT_BLE    &out OUT_USB    &trans          &trans
                &trans      &trans                                                                                                                  &trans          &trans
                                            &trans  &trans  &trans                                          &trans  &sl SYSCTRL     &trans
                                            &trans  &trans  &trans                                          &trans  &trans          &trans
            >;
        };

        num{
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &kp KP_NUM  &kp KP_SLASH  &kp KP_ASTERISK    &kp KP_MINUS    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &kp KP_N7   &kp KP_N8     &kp KP_N9          &kp KP_PLUS     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &kp KP_N4   &kp KP_N5     &kp KP_N6          &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &kp KP_N1   &kp KP_N2     &kp KP_N3          &trans          &trans
        &trans  &trans                                                                                  &kp KP_N0     &kp KP_DOT
                                &trans  &trans  &trans                      &trans  &trans  &trans
                                &trans  &trans  &trans                      &trans  &trans  &trans
            >;
        };

        sysctrl{
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &bootloader                 &trans  &trans  &trans      &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans      &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans      &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans      &trans  &trans  &trans  &trans
                        &trans  &trans                                                      &bt BT_CLR  &trans
                                        &trans  &trans  &trans      &trans  &trans  &trans
                                        &trans  &trans  &trans      &trans  &trans  &trans
            >;
        };

//         FN{
//             bindings = <
// &trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans
// &trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans
// &trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans
// &trans  &trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans  &trans
//                 &trans  &trans                                                       &trans  &trans
//                                 &trans  &trans  &trans       &trans  &trans  &trans
//                                 &trans  &trans  &trans       &trans  &trans  &trans
//             >;
//         };



   };
};
