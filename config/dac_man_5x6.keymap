&uc {
    default-mode = <UC_MODE_LINUX>;
};

/ {

    macros{

        ZMK_MACRO(linux_unicode_enter,
        bindings =  <&macro_press &kp LCTRL &kp LSHIFT &kp U>,
                    <&macro_release &kp LCTRL &kp LSHIFT &kp U>;
        )

        ZMK_MACRO(alpha_s,
            bindings = <&kp N3 &kp B &kp N1 &kp ENTER >;
        )

        ZMK_MACRO(beta_s,
            bindings = <&kp N3 &kp B &kp N2 &kp ENTER >;
        )

        ZMK_MACRO(gamma_s,
            bindings = <&kp N3 &kp B &kp N3 &kp ENTER >;
        )

        ZMK_MACRO(delta_c,
            bindings = <&kp N3 &kp N9 &kp N4 &kp ENTER >;
        )

        ZMK_MACRO(epsilon_s,
            bindings = <&kp N3 &kp B &kp N5 &kp ENTER >;
        )

        ZMK_MACRO(element_of,
            bindings = <&kp N2 &kp N2 &kp N0 &kp N8 &kp ENTER >;
        )

        ZMK_MACRO(not_element_of,
            bindings = <&kp N2 &kp N2 &kp N0 &kp N9 &kp ENTER >;
        )

