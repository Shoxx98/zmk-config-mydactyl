// carpalx: outputs-everythin_colemakstart //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
        default_layer {
            bindings = <
&kp N2  &kp N3      &kp N4      &kp GRAVE   &kp FSLH    &kp N5      &kp HOME                                &kp PAGE_UP             &kp N6      &kp COMMA   &kp SEMICOLON   &kp N7      &kp N8      &kp N9
&kp N1  &kp LBKT    &kp Q       &kp P       &kp L       &kp M       &lt MATH INSERT                         &lt MATH PSCRN          &kp U       &kp B       &kp O           &kp V       &kp RBKT    &kp N0
&kp TAB &kp D       &kp S       &kp T       &kp R       &kp N       &lt UMLAUT END                          &lt UMLAUT PAGE_DOWN    &kp A       &kp I       &kp E           &kp C       &kp F       &kp H    
&kp ESC &kp MINUS   &kp J       &kp G       &kp K       &kp Z                                                                       &kp W       &kp X       &kp Y           &kp EQUAL   &kp BSLH    &kp BSPC
                    &tog NUM    &lt MOUSE P                                                                                                                 &kp DOT         &kp APOSTROPHE
                                            &kp ENTER   &kp SPACE   &kp LCTRL                               &tog FN                 &kp CAPS    &kp RCTRL
                                            &kp LWIN    &kp LSHIFT  &kp LALT                                &kp DEL                 &kp RSHIFT  &kp RWIN
            >;
        };
// carpalx: outputs-everythin_colemakstart //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

        fn{
            bindings = <
&kp F2          &kp F3          &kp F4      &trans          &trans      &kp F5  &bt BT_SEL 0                                    &bt BT_SEL 3  &kp F6    &trans    &trans          &kp F7         &kp F8  &kp F9
&kp F1          &trans          &trans      &kp UP          &trans      &trans  &bt BT_SEL 1                                    &bt BT_SEL 4  &trans    &trans    &trans          &trans         &trans  &kp F10
&trans          &trans          &kp LEFT    &kp DOWN        &kp RIGHT   &trans  &bt BT_SEL 2                                    &trans        &trans    &trans    &trans          &to CAMEL_CASE &trans  &kp F11
&sl SYSCTRL     &to SNAKE_CASE  &trans      &trans          &trans      &trans                                                                &trans    &trans    &out OUT_BLE    &out OUT_USB   &trans  &kp F12
                                &trans      &trans                                                                                                      &trans          &trans
                                                            &trans      &trans  &trans                                          &trans        &trans    &trans
                                                            &trans      &trans  &trans                                          &trans        &trans    &trans
            >;
        };

        num{
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &kp KP_NUM  &kp KP_SLASH  &kp KP_ASTERISK    &kp KP_MINUS    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &kp KP_N7   &kp KP_N8     &kp KP_N9          &kp KP_PLUS     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &kp KP_N4   &kp KP_N5     &kp KP_N6          &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &kp KP_N1   &kp KP_N2     &kp KP_N3          &trans          &trans
        &trans  &trans                                                                                  &kp KP_N0     &kp KP_DOT
                                &trans  &trans  &trans                      &trans  &trans  &trans
                                &trans  &trans  &trans                      &trans  &trans  &trans
            >;
        };

        sysctrl{
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &bootloader                 &trans  &trans  &trans      &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans      &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans      &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans      &trans  &trans  &trans  &trans
                        &trans  &trans                                                      &bt BT_CLR  &trans
                                        &trans  &trans  &trans      &trans  &trans  &trans
                                        &trans  &trans  &trans      &trans  &trans  &trans
            >;
        };

        mouse{
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans         &trans          &trans          &trans          &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans         &mkp MB1        &mkp MB2        &trans          &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans  &mmv MOVE_LEFT &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                       &trans         &trans          &trans          &trans          &trans  &trans
                &trans  &trans                                                                      &trans          &trans
                                &trans  &trans  &trans       &trans  &trans         &trans
                                &trans  &trans  &trans       &trans  &trans         &trans
            >;
        };


        math{
            bindings = <
&trans  &trans              &trans          &trans          &trans          &trans          &trans                  &trans  &trans              &trans                  &trans                  &trans          &trans              &trans
&trans  &linux_math_brack_l &linux_pi_s     &trans          &linux_lambda_s &linux_mu_s     &trans                  &trans  &linux_logic_or     &linux_beta_s           &linux_element_of       &linux_phi_s    &linux_math_brack_r &trans
&trans  &trans              &linux_sigma_s  &linux_tau_s    &linux_rho_s    &linux_nu_s     &trans                  &trans  &linux_alpha_s      &trans                  &linux_epsilon_s        &linux_gamma_s  &trans              &linux_theta_s
&trans  &trans              &trans          &trans          &linux_kappa_s  &linux_omega_s                                  &trans              &linux_there_exists     &linux_psi_s            &trans          &trans              &trans
                            &trans          &trans                                                                                                                      &trans                  &trans
                                                            &trans          &trans          &trans                  &trans  &trans              &trans
                                                            &trans          &lt MATH_C      &trans                  &trans  &trans              &trans
            >;
        };



        math_c{
            bindings = <
&trans  &trans              &trans          &trans          &trans          &trans          &trans                  &trans  &trans              &trans                  &trans                  &trans          &trans              &trans
&trans  &trans              &trans          &trans          &linux_lambda_c &trans          &trans                  &trans  &linux_logic_and    &trans                  &linux_not_element_of   &linux_phi_c    &trans              &trans
&trans  &linux_delta_c      &linux_sigma_c  &trans          &trans          &trans          &trans                  &trans  &linux_for_all      &trans                  &trans                  &trans          &trans              &trans
&trans  &trans              &trans          &trans          &trans          &linux_omega_c                                  &trans              &linux_there_n_exists   &trans                  &trans          &trans              &trans
