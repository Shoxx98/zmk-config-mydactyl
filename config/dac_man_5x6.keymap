#define INDEX_BRACK_L 15
#define INDEX_Q 16
#define INDEX_P 17
#define INDEX_L 18
#define INDEX_M 19
#define INDEX_U 22
#define INDEX_B 23
#define INDEX_O 24
#define INDEX_V 25
#define INDEX_BRACK_R 26
#define INDEX_D 29
#define INDEX_S 30
#define INDEX_T 31
#define INDEX_R 32
#define INDEX_N 33
#define INDEX_A 36
#define INDEX_I 37
